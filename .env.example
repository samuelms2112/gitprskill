# Copie este arquivo para .env e ajuste os valores.
# NUNCA versione o arquivo .env (ele está no .gitignore).
# Use apenas letras e números na senha do banco: ela é embutida em DATABASE_URL.

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# PostgreSQL (usado pelo docker-compose)
POSTGRES_DB=github_management
POSTGRES_USER=ghmgmt
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# URL de conexão da aplicação quando executada fora do Docker
DATABASE_URL=postgresql+asyncpg://ghmgmt:troque_esta_senha@localhost:5432/github_management
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis (broker do Celery)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Frontend (destino do login e origens CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API
API_PORT=8000

# Sessão JWT: gere com `openssl rand -hex 32` (mínimo de 32 caracteres)
JWT_SECRET_KEY=troque_por_uma_chave_aleatoria_de_pelo_menos_32_caracteres
JWT_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_STATE_TTL_MINUTES=10

# GitHub OAuth App (login de usuários)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email read:org

# Integrações externas (preencha quando forem necessárias)
# GitHub App: autenticação por instalação (um token temporário por tenant).
# Chave privada em PEM; pode ser colada com \n escapados numa única linha.
GITHUB_APP_ID=
# Nome curto do App (github.com/apps/<slug>): usado pelo anti-loop e pela menção ao bot.
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Segredo configurado no webhook do GitHub. Sem ele, todas as entregas são rejeitadas.
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_MAX_RATE_LIMIT_WAIT_SECONDS=900
# Branches de destino cujos merges são registrados
TRACKED_BASE_BRANCHES=main,master,master-tip
# Provedor de IA: "claude_cli" (Claude Code CLI autenticado na máquina) ou "gemini" (nuvem, com cota).
AI_PROVIDER=claude_cli
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=claude-sonnet-5-5
CLAUDE_CLI_TIMEOUT_SECONDS=300
CLAUDE_MAX_DIFF_CHARS=60000

# Google Gemini (análise de PRs e release notes). Deixe vazio para desativar a IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_DIFF_CHARS=60000
