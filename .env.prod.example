# Modelo do .env de PRODUÇÃO. No servidor: cp .env.prod.example .env e preencha os campos vazios.
# O script de deploy RECUSA rodar enquanto houver "troque" ou "seu-dominio" neste arquivo.
# NUNCA versione o .env real.

ENVIRONMENT=production
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Domínio público (já apontando para o IP do Droplet no DNS). Sem https:// e sem barra.
DOMAIN=seu-dominio.com

# PostgreSQL (use apenas letras e números na senha)
POSTGRES_DB=github_management
POSTGRES_USER=ghmgmt
POSTGRES_PASSWORD=troque_esta_senha_longa

# Sessão JWT: gere com `openssl rand -hex 32`
JWT_SECRET_KEY=troque_por_uma_chave_de_64_caracteres_hex
JWT_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_STATE_TTL_MINUTES=10

# GitHub OAuth App (login). Callback: https://DOMINIO/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://seu-dominio.com/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email

# GitHub App (leitura de PRs). Webhook: https://DOMINIO/api/v1/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_MAX_RATE_LIMIT_WAIT_SECONDS=900
TRACKED_BASE_BRANCHES=main,master,master-tip

# IA. Em Droplet pequeno, o conselho local é lento: o modelo leve abaixo é o padrão.
# Para velocidade, use AI_PROVIDER=gemini (com GEMINI_API_KEY preenchida).
AI_PROVIDER=ollama
OLLAMA_MODELS=qwen2.5-coder:3b
OLLAMA_PM_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=900
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_DIFF_CHARS=60000

# Frontend: o navegador acessa tudo pelo próprio domínio.
FRONTEND_URL=https://seu-dominio.com
CORS_ALLOWED_ORIGINS=https://seu-dominio.com
